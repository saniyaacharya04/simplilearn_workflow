{
  "audio_file": "group_5_pair_1_statement1.wav",
  "duration": 44.64,
  "segments": [
    {
      "id": 0,
      "start": 0.0,
      "end": 3.34,
      "duration": 3.34,
      "text": "because not every problem needs the same architecture."
    },
    {
      "id": 1,
      "start": 3.34,
      "end": 6.16,
      "duration": 2.82,
      "text": "The first type is the reactive agent."
    },
    {
      "id": 2,
      "start": 6.16,
      "end": 9.48,
      "duration": 3.32,
      "text": "A reactive agent responds to its current input"
    },
    {
      "id": 3,
      "start": 9.48,
      "end": 11.5,
      "duration": 2.02,
      "text": "using predefined rules."
    },
    {
      "id": 4,
      "start": 12.58,
      "end": 15.18,
      "duration": 2.6,
      "text": "It has no memory of what happened before,"
    },
    {
      "id": 5,
      "start": 15.18,
      "end": 17.18,
      "duration": 2.0,
      "text": "no ability to plan ahead."
    },
    {
      "id": 6,
      "start": 17.18,
      "end": 20.16,
      "duration": 2.98,
      "text": "It simply observes a condition and responds."
    },
    {
      "id": 7,
      "start": 20.16,
      "end": 22.82,
      "duration": 2.66,
      "text": "Think of a simple alert agent at Solara."
    },
    {
      "id": 8,
      "start": 22.82,
      "end": 27.16,
      "duration": 4.34,
      "text": "If output at site 12 drops below 8% of a baseline,"
    },
    {
      "id": 9,
      "start": 27.16,
      "end": 28.88,
      "duration": 1.72,
      "text": "send a notification."
    },
    {
      "id": 10,
      "start": 28.88,
      "end": 30.84,
      "duration": 1.96,
      "text": "That's a reactive agent."
    },
    {
      "id": 11,
      "start": 30.84,
      "end": 35.28,
      "duration": 4.44,
      "text": "Fast, predictable, easy to build, but limited."
    },
    {
      "id": 12,
      "start": 35.28,
      "end": 38.32,
      "duration": 3.04,
      "text": "It can't investigate why the drop happened"
    },
    {
      "id": 13,
      "start": 38.32,
      "end": 42.28,
      "duration": 3.96,
      "text": "or determine whether the alert is actually worth sending."
    },
    {
      "id": 14,
      "start": 42.28,
      "end": 44.34,
      "duration": 2.06,
      "text": "The second type is the goal-based agent."
    }
  ],
