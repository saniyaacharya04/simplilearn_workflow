  "segments": [
    {
      "id": 0,
      "start": 0.0,
      "end": 6.06,
      "duration": 6.06,
      "text": "A goal-based agent reasons about actions in terms of whether they move it closer to a defined outcome."
    },
    {
      "id": 1,
      "start": 6.76,
      "end": 12.74,
      "duration": 5.98,
      "text": "It plans. It evaluates options. It chooses the path most likely to achieve the goal."
    },
    {
      "id": 2,
      "start": 13.62,
      "end": 17.18,
      "duration": 3.56,
      "text": "Solara's site performance investigation agent works this way."
    },
    {
      "id": 3,
      "start": 17.78,
      "end": 22.72,
      "duration": 4.94,
      "text": "Its goal is to determine why site 47 underperformed last Tuesday."
    },
    {
      "id": 4,
      "start": 23.08,
      "end": 25.2,
      "duration": 2.12,
      "text": "It doesn't follow a fixed script."
    },
    {
      "id": 5,
      "start": 25.52,
      "end": 31.74,
      "duration": 6.22,
      "text": "It decides what data to pull based on what it finds, adjusting its approach as results come in."
    },
    {
      "id": 6,
      "start": 32.48,
      "end": 35.16,
      "duration": 2.68,
      "text": "The third type is the utility-based agent."
    }
  ],
