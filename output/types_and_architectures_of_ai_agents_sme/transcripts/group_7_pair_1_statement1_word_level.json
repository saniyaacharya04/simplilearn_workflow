{
  "audio_file": "group_7_pair_1_statement1.wav",
  "duration": 44.62,
  "segments": [
    {
      "id": 0,
      "start": 0.0,
      "end": 4.14,
      "duration": 4.14,
      "text": "A utility-based agent goes further than goal-based reasoning."
    },
    {
      "id": 1,
      "start": 4.74,
      "end": 7.84,
      "duration": 3.1,
      "text": "It doesn't just ask, will this action achieve the goal?"
    },
    {
      "id": 2,
      "start": 8.26,
      "end": 17.72,
      "duration": 9.46,
      "text": "It asks, which available action achieves the goal most efficiently, at the lowest cost, and with the highest confidence?"
    },
    {
      "id": 3,
      "start": 18.6,
      "end": 27.36,
      "duration": 8.76,
      "text": "At Solara, a utility-based agent managing report generation across hundreds of sites needs to make trade-off decisions constantly."
    },
    {
      "id": 4,
      "start": 27.36,
      "end": 34.3,
      "duration": 6.94,
      "text": "Do I generate a full diagnostic report or a summary? Do I escalate this anomaly"
    },
    {
      "id": 5,
      "start": 34.3,
      "end": 39.76,
      "duration": 5.46,
      "text": "or log it for review? It evaluates options against a utility function and"
    },
    {
      "id": 6,
      "start": 39.76,
      "end": 44.14,
      "duration": 4.38,
      "text": "picks the best one. Let's zoom out and look at how"
    }
  ],
